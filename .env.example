# Embedding backend: "local" (sentence-transformers) or "openai"
EMBEDUINO_EMBEDDING_BACKEND=local

# Local model (used when backend=local)
EMBEDUINO_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI (only needed when EMBEDUINO_EMBEDDING_BACKEND=openai
# or when using OpenAI for generation)
OPENAI_API_KEY=
EMBEDUINO_OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDUINO_OPENAI_CHAT_MODEL=gpt-4o-mini

# Generation: "local" (extractive / template) or "openai"
EMBEDUINO_GENERATION_BACKEND=local

# Retrieval
EMBEDUINO_TOP_K=4
EMBEDUINO_MIN_SCORE=0.30
EMBEDUINO_CHROMA_PATH=.chroma
EMBEDUINO_COLLECTION=embeduino_docs

# SerpApi (for live web search; free tier: 250 searches/month)
SERPAPI_API_KEY=

# Web search mode: "auto" (trigger on weak local results or new topics),
# "always" (every question), "off" (disable)
EMBEDUINO_WEB_MODE=auto

# Number of SerpApi organic results to retrieve
EMBEDUINO_WEB_NUM=5

# Trusted sites for web search (space-separated)
EMBEDUINO_WEB_SITES=docs.arduino.cc github.com forum.arduino.cc

# SerpApi cache directory (on-disk, gitignored)
EMBEDUINO_SERP_CACHE=.serp_cache

# Max SerpApi calls per run (credit safety cap)
EMBEDUINO_SERP_MAX_CALLS=10

# SerpApi search timeout (seconds, includes async polling time)
SERPAPI_TIMEOUT_S=90

# Reciprocal Rank Fusion k parameter
EMBEDUINO_RRF_K=60
