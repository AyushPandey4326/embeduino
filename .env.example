# Embedding backend: "local" (sentence-transformers) or "openai"
EMBEDUINO_EMBEDDING_BACKEND=local

# Local model (used when backend=local)
EMBEDUINO_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI (only needed when EMBEDUINO_EMBEDDING_BACKEND=openai
# or when using OpenAI for generation)
OPENAI_API_KEY=
EMBEDUINO_OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDUINO_OPENAI_CHAT_MODEL=gpt-4o-mini

# Generation: "local" (extractive / template) or "openai"
EMBEDUINO_GENERATION_BACKEND=local

# Retrieval
EMBEDUINO_TOP_K=4
EMBEDUINO_MIN_SCORE=0.30
EMBEDUINO_CHROMA_PATH=.chroma
EMBEDUINO_COLLECTION=embeduino_docs
